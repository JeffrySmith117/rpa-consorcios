# Copie este arquivo para .env e preencha. O .env NÃO vai para o Git.

# ---------------------------------------------------------------
# WhatsApp: link | meta | twilio | mock
#   link   = abre o WhatsApp de quem usa o sistema com a mensagem pronta (padrão, sem credenciais)
#   meta   = WhatsApp Cloud API oficial (envio 100% automático)
#   twilio = Twilio API for WhatsApp (sandbox)
#   mock   = não envia de verdade, só registra no log
# ---------------------------------------------------------------
WHATSAPP_PROVIDER=link

# --- Meta WhatsApp Cloud API (developers.facebook.com > seu app > WhatsApp > API Setup)
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_API_VERSION=v21.0

# --- Twilio (console.twilio.com > Messaging > Try it out > WhatsApp)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ---------------------------------------------------------------
# RPA
# ---------------------------------------------------------------
# Ponto de partida da navegação (catálogo de Dados Abertos).
# Deixe vazio para o robô ir direto ao formulário de consulta.
BCB_DADOS_ABERTOS_URL=https://dadosabertos.bcb.gov.br/
# false = abre o navegador visível (bom para demonstrar a automação)
RPA_HEADLESS=true
RPA_TIMEOUT_MS=30000
RPA_MAX_TENTATIVAS=3
# Se o portal falhar em todas as tentativas, consulta a API OData direto
RPA_FALLBACK_API=true

# ---------------------------------------------------------------
# Aplicação
# ---------------------------------------------------------------
# DATABASE_URL=sqlite:///data/rpa.db
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173